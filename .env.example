# ---------- Shared ----------
NODE_ENV=development

# ---------- API (apps/api) ----------
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql://umrah:umrah_dev_password@localhost:5432/umrah_travel?schema=public
REDIS_URL=redis://localhost:6379

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-xxxxxxxx
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-xxxxxxx
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# AES-256-GCM key for passport/CNIC fields: 32 bytes, base64.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FIELD_ENCRYPTION_KEY=
# HMAC key for searchable hashes of sensitive identifiers (min 32 chars)
FIELD_HASH_KEY=

# Storage (private bucket for passports/CNIC, public bucket/CDN for marketing media)
AWS_REGION=me-central-1
S3_PRIVATE_BUCKET=umrah-private-docs
S3_PUBLIC_BUCKET=umrah-public-media
S3_SIGNED_URL_TTL_SECONDS=300

# Email: ses | resend
EMAIL_PROVIDER=resend
EMAIL_FROM="Umrah Travel <no-reply@example.com>"
RESEND_API_KEY=

# WhatsApp Business Platform (Cloud API)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Payments: provider key selects the gateway adapter (configured in Phase 7)
PAYMENT_PROVIDER=manual
PAYMENT_WEBHOOK_SECRET=

# Seed (first Super Admin). Password min 12 chars.
SEED_SUPERADMIN_EMAIL=admin@example.com
SEED_SUPERADMIN_PASSWORD=
SEED_SUPERADMIN_NAME=Super Admin

# ---------- Web (apps/web) ----------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Optional: CDN/S3 hostname for public media (enables next/image remote optimisation)
NEXT_PUBLIC_MEDIA_HOST=
# Set to 1 to expose /design-system in production builds (leave unset)
ENABLE_DESIGN_SYSTEM_PAGE=

# API: number of reverse proxies in front of the API (0 locally, 1 behind a load balancer)
TRUST_PROXY=0
# Shared secret (>=24 chars) sent by the Next.js server so SSR requests skip per-IP rate limits. Also set on web.
INTERNAL_API_KEY=
# Web (server-side): where the Next.js server reaches the API
API_INTERNAL_URL=http://localhost:4000/api/v1
# Set to 1 once the online booking flow ships (Phase 5) to show "Book now" instead of enquiry-only CTAs
NEXT_PUBLIC_ONLINE_BOOKING=
