enum BookingStatus {
  DRAFT
  PENDING_PAYMENT
  CONFIRMED
  VISA_PROCESSING
  TRAVEL_PREPARATION
  COMPLETED
  CANCELLED
}

/// Wizard step for DRAFT bookings so customers can resume.
enum BookingStep {
  PACKAGE
  DATE
  TRAVELERS
  ROOMS
  TRAVELER_DETAILS
  DOCUMENTS
  PAYMENT
  CONFIRMATION
}

/// Aggregate payment position of a booking (derived from payments/installments).
enum BookingPaymentStatus {
  UNPAID
  DEPOSIT_PAID
  PARTIALLY_PAID
  PAID
  OVERDUE
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
}

enum TravelerType {
  ADULT
  CHILD
  INFANT
}

enum BookingSource {
  WEBSITE
  STAFF
  QUOTATION
  WHATSAPP
  PHONE
  WALK_IN
}

model Booking {
  id                 String               @id @default(uuid(7)) @db.Uuid
  reference          String               @unique // e.g. UMR-2026-000123
  customerId         String               @db.Uuid
  packageId          String               @db.Uuid
  departureId        String               @db.Uuid
  status             BookingStatus        @default(DRAFT)
  currentStep        BookingStep          @default(DATE)
  paymentStatus      BookingPaymentStatus @default(UNPAID)
  source             BookingSource        @default(WEBSITE)
  adults             Int                  @default(1)
  children           Int                  @default(0)
  infants            Int                  @default(0)
  currency           String               @default("PKR")
  subtotal           Decimal              @default(0) @db.Decimal(12, 2)
  discountTotal      Decimal              @default(0) @db.Decimal(12, 2)
  taxTotal           Decimal              @default(0) @db.Decimal(12, 2)
  grandTotal         Decimal              @default(0) @db.Decimal(12, 2)
  depositAmount      Decimal              @default(0) @db.Decimal(12, 2)
  amountPaid         Decimal              @default(0) @db.Decimal(12, 2)
  amountRefunded     Decimal              @default(0) @db.Decimal(12, 2)
  balanceDue         Decimal              @default(0) @db.Decimal(12, 2)
  balanceDueDate     DateTime?            @db.Date
  /// Immutable copy of package/departure/pricing at time of booking.
  pricingSnapshot    Json?
  seatHoldExpiresAt  DateTime?
  specialRequests    String?
  internalNotes      String?
  assignedToId       String?              @db.Uuid
  createdById        String?              @db.Uuid
  leadId             String?              @db.Uuid
  quotationId        String?              @unique @db.Uuid
  submittedAt        DateTime?
  confirmedAt        DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  deletedAt          DateTime?

  customer         Customer               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  package          Package                @relation(fields: [packageId], references: [id], onDelete: Restrict)
  departure        PackageDeparture       @relation(fields: [departureId], references: [id], onDelete: Restrict)
  assignedTo       User?                  @relation("BookingAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy        User?                  @relation("BookingCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lead             Lead?                  @relation(fields: [leadId], references: [id], onDelete: SetNull)
  quotation        Quotation?             @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  rooms            BookingRoom[]
  travelers        BookingTraveler[]
  statusHistory    BookingStatusHistory[]
  payments         Payment[]
  installments     PaymentInstallment[]
  refunds          Refund[]
  invoices         Invoice[]
  documents        Document[]
  visaApplications VisaApplication[]
  followUps        FollowUp[]
  notes            CrmNote[]
  communications   Communication[]
  supportRequests  SupportRequest[]
  reviews          Review[]

  @@index([customerId, status])
  @@index([departureId])
  @@index([status, paymentStatus])
  @@index([assignedToId])
  @@index([createdAt])
}

model BookingRoom {
  id            String            @id @default(uuid(7)) @db.Uuid
  bookingId     String            @db.Uuid
  occupancy     RoomOccupancy
  hotelId       String?           @db.Uuid
  label         String?
  pricePerAdult Decimal           @db.Decimal(12, 2)
  sortOrder     Int               @default(0)
  booking       Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  hotel         Hotel?            @relation(fields: [hotelId], references: [id], onDelete: SetNull)
  travelers     BookingTraveler[]

  @@index([bookingId])
}

model BookingTraveler {
  id             String       @id @default(uuid(7)) @db.Uuid
  bookingId      String       @db.Uuid
  travelerId     String       @db.Uuid
  bookingRoomId  String?      @db.Uuid
  travelerType   TravelerType
  isLeadTraveler Boolean      @default(false)
  price          Decimal      @db.Decimal(12, 2)
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  traveler       Traveler     @relation(fields: [travelerId], references: [id], onDelete: Restrict)
  room           BookingRoom? @relation(fields: [bookingRoomId], references: [id], onDelete: SetNull)

  @@unique([bookingId, travelerId])
  @@index([travelerId])
}

model BookingStatusHistory {
  id          String         @id @default(uuid(7)) @db.Uuid
  bookingId   String         @db.Uuid
  fromStatus  BookingStatus?
  toStatus    BookingStatus
  changedById String?        @db.Uuid
  note        String?
  createdAt   DateTime       @default(now())
  booking     Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  changedBy   User?          @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
}
